{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "codebase-memory-mcp": {
        "type": "local",
        "command": ["codebase-memory-mcp"]
      },
      "jetbrains-rider": {
        "type": "local",
        "command": ["java", "-classpath", "{env:RIDER_MCP_CLASSPATH}", "com.intellij.mcpserver.stdio.McpStdioRunnerKt"],
        "environment": {
          "IJ_MCP_SERVER_PORT": "{env:IJ_MCP_SERVER_PORT}"
        },
        "disabled": true
      }
    }
  }
}
